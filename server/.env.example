PORT=5000
NODE_ENV=development
JWT_SECRET=your-super-secret-jwt-key-change-in-production
ADMIN_PASSWORD=Admin@123456
CLIENT_URL=http://localhost:5173
OPENAI_API_KEY=sk-your-openai-api-key-here
